<Project>
  <!-- Defaults inocuos para todo el repo. TargetFramework y TreatWarningsAsErrors
       se fijan por proyecto (solo Grupo 1) para no romper Grupo 2/3/4. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
</Project>
